    {
      "parameters": {
        "jsCode": "// Improved LinkedIn Company Extraction\nfor (let item of items) {\n  const results = item.json.organic_results;\n  const processedProfiles = [];\n  \n  for (const result of results) {\n    let name = result.title.split(' - ')[0] || result.title.split(' | ')[0] || 'Unknown';\n    name = name.replace('CEO of', '').replace('CEO at', '').replace('CEO', '').trim();\n    \n    // IMPROVED COMPANY EXTRACTION\n    let company = extractCompany(result);\n    \n    // BETTER DOMAIN EXTRACTION\n    let domain = extractDomain(result, company);\n    \n    // Only include profiles with valid companies\n    if (company && domain && !domain.includes('unknown')) {\n      processedProfiles.push({\n        name: name.trim(),\n        title: result.title,\n        linkedin_url: result.link,\n        company: company.trim(),\n        snippet: result.snippet,\n        position: result.position,\n        company_domain: domain\n      });\n    }\n  }\n  \n  item.json = {\n    search_metadata: item.json.search_metadata,\n    profiles: processedProfiles,\n    total_profiles: processedProfiles.length\n  };\n}\n\n// IMPROVED COMPANY EXTRACTION\nfunction extractCompany(result) {\n  // Method 1: Extract from title pattern \"Name - Company\"\n  if (result.title.includes(' - ')) {\n    const afterDash = result.title.split(' - ')[1];\n    if (!afterDash.includes('San Francisco') && !afterDash.includes('LinkedIn')) {\n      return afterDash.split(' |')[0].split(' at ')[0].trim();\n    }\n  }\n  \n  // Method 2: Extract from rich snippet extensions\n  if (result.rich_snippet && result.rich_snippet.top && result.rich_snippet.top.extensions) {\n    const extensions = result.rich_snippet.top.extensions;\n    for (const ext of extensions) {\n      if (ext && typeof ext === 'string' && !ext.includes('San Francisco') && !ext.includes('LinkedIn')) {\n        if (ext.length > 3 && ext.length < 50) {\n          return ext.trim();\n        }\n      }\n    }\n  }\n  \n  // Method 3: Extract from snippet \"at Company\"\n  if (result.snippet.includes(' at ')) {\n    const companyMatch = result.snippet.split(' at ')[1]?.split(' ·')[0]?.split(' .')[0];\n    if (companyMatch && companyMatch.length > 3) {\n      return companyMatch.trim();\n    }\n  }\n  \n  // Method 4: Manual mapping for known profiles\n  const knownCompanies = {\n    'Marc Benioff': 'Salesforce',\n    'Sasha Orloff': 'Puzzle', \n    'Nazar Gulyk': 'Techstars',\n    'Simon Khalaf': '', // Need to research\n    'Yamini Rangan': 'HubSpot'\n  };\n  \n  return knownCompanies[result.title.split(' - ')[0]] || '';\n}\n\n// IMPROVED DOMAIN EXTRACTION\nfunction extractDomain(result, company) {\n  // Method 1: Known company domains\n  const knownDomains = {\n    'Salesforce': 'salesforce.com',\n    'HubSpot': 'hubspot.com', \n    'Techstars': 'techstars.com',\n    'Puzzle': 'puzzle.io',\n    'Lever': 'lever.co'\n  };\n  \n  if (company && knownDomains[company]) {\n    return knownDomains[company];\n  }\n  \n  // Method 2: Convert company name to domain\n  if (company && company.length > 2) {\n    const cleanDomain = company.toLowerCase()\n      .replace(/[^a-z0-9]/g, '')\n      .replace(/\\s+/g, '')\n      .replace(/llc|inc|corp|corporation|company|co|tech|technologies|solutions/g, '');\n    \n    if (cleanDomain.length > 3) {\n      return cleanDomain + '.com';\n    }\n  }\n  \n  return ''; // Return empty instead of unknown-company.com\n}\n\nreturn items;"
      },
