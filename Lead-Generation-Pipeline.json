    {
      "parameters": {
        "jsCode": "// Extract Real Company from Email Domain\nconst items = $input.all();\n\nfor (let item of items) {\n  const email = item.json.value || '';\n  let company = 'Unknown Company';\n  \n  // Extract company from email domain\n  if (email.includes('@salesforce.com')) {\n    company = 'Salesforce';\n  } else if (email.includes('@hubspot.com')) {\n    company = 'HubSpot';\n  } else if (email.includes('@techstars.com')) {\n    company = 'Techstars';\n  } else if (email.includes('@lever.co')) {\n    company = 'Lever';\n  } else if (email.includes('@')) {\n    // Extract domain and convert to company name\n    const domain = email.split('@')[1];\n    company = domain.split('.')[0];\n    company = company.charAt(0).toUpperCase() + company.slice(1);\n  }\n  \n  item.json.processedData = {\n    name: item.json.first_name + ' ' + item.json.last_name,\n    email: item.json.value,\n    company: company,\n    message: 'Position: ' + item.json.position + ' | Department: ' + item.json.department + ' | Source: Hunter.io'\n  };\n}\n\nreturn items;"
      },
