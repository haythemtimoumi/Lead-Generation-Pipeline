    {
      "parameters": {
        "jsCode": "// Clean and Validate Domains for Hunter.io\nfor (let item of items) {\n  // Clean up company names\n  if (item.json.company) {\n    item.json.company = item.json.company\n      .split(',')[0]  // Remove everything after comma\n      .split(' at ')[0]  // Remove everything after \"at\"\n      .split(' of ')[0]  // Remove everything after \"of\"\n      .replace(' a modern CRM company that', '')\n      .trim();\n  }\n  \n  // Fix specific problematic domains\n  if (item.json.company_domain === 'hubspotamoderncrmthat.com') {\n    item.json.company_domain = 'hubspot.com';\n  }\n  \n  const currentDomain = item.json.company_domain;\n  \n  // Known valid domains\n  const validDomains = [\n    'hubspot.com',\n    'techstars.com', \n    'salesforce.com',\n    'puzzle.io',\n    'lever.co'\n  ];\n  \n  // Known invalid domains\n  const invalidDomains = [\n    'ceoofinsfnsulting.com',\n    'itmanager.com',\n    'unknown-company.com',\n    'example.com'\n  ];\n  \n  // Validate domain\n  if (validDomains.includes(currentDomain)) {\n    item.json.domain_status = 'valid';\n  } else if (invalidDomains.includes(currentDomain)) {\n    item.json.domain_status = 'invalid';\n    item.json.skip_hunter = true;\n  } else {\n    // Check if domain looks real\n    const looksReal = currentDomain && \n                     currentDomain.includes('.') &&\n                     !currentDomain.includes('ceo') &&\n                     !currentDomain.includes('manager') &&\n                     !currentDomain.includes(' ') &&\n                     currentDomain.length > 6;\n    \n    if (looksReal) {\n      item.json.domain_status = 'unknown_but_valid';\n    } else {\n      item.json.domain_status = 'invalid';\n      item.json.skip_hunter = true;\n    }\n  }\n  \n  console.log('Domain Check:', {\n    name: item.json.name,\n    domain: item.json.company_domain,\n    status: item.json.domain_status,\n    send_to_hunter: !item.json.skip_hunter\n  });\n}\n\nreturn items;"
      },
